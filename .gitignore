# Eval workspace (generated locally, never shipped)
workspace/

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# aislop runtime artifacts (the umbrella on-save hook fires on submodule edits too).
# Keep only a config if one is added later.

# aislop runtime artifacts (session/history logs, caches, baselines).
# Unanchored so nested project directories are covered too.
**/.aislop/*
!**/.aislop/config.yml
